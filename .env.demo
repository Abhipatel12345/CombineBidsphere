# Demo / staging build mode — committed so VM & CI can enable Demo MFA
# without relying on a gitignored local `.env`.
#
# Usage:
#   npm run build:demo
#   # or: npx vite build --mode demo
#
# Vite loads: .env → .env.local → .env.demo → .env.demo.local

VITE_BIDSPHERE_COMPANY_NAME=Netlink
VITE_BIDSPHERE_DEMO_MFA=true
BIDSPHERE_DEMO_MFA=true
BIDSPHERE_APP_ENV=demo
