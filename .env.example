# =============================================================================
# BidSphere + Project Management (PDM) Unified Platform Environment Template
# =============================================================================

# --- BidSphere (Procure-to-Pay) ERPNext Instance ---
BIDSPHERE_ERP_URL=http://your-bidsphere-erpnext-instance:8090/
BIDSPHERE_ERP_API_KEY=your_bidsphere_api_key
BIDSPHERE_ERP_API_SECRET=your_bidsphere_api_secret
VITE_BIDSPHERE_ERP_URL=http://your-bidsphere-erpnext-instance:8090/
VITE_BIDSPHERE_COMPANY_NAME=Netlink

# --- Project Management (PDM) ERPNext Instance ---
PDM_ERP_URL=http://your-pdm-erpnext-instance:8083
PDM_ERP_API_KEY=your_pdm_api_key
PDM_ERP_API_SECRET=your_pdm_api_secret
NEXT_PUBLIC_PDM_ERP_URL=http://your-pdm-erpnext-instance:8083

# --- Unified Gateway & Session Handling ---
SESSION_SECRET=your_secure_random_session_secret_here
PORT=3000
PDM_PORT=3001
BIDSPHERE_PORT=5173
NODE_ENV=development

