{
  "name": "combine-bidsphere",
  "version": "1.0.0",
  "private": true,
  "description": "CombineBidsphere Monorepo containing Bidsphere (Procure-to-Pay) and PDM Frontend",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "gateway": "node gateway/server.mjs",
    "dev:bidsphere": "npm run dev --workspace=apps/bidsphere -- --port 5173",
    "dev:pdm": "npm run dev --workspace=apps/pdm -- -p 3001",
    "build:bidsphere": "npm run build --workspace=apps/bidsphere",
    "build:pdm": "npm run build --workspace=apps/pdm",
    "build": "npm run build --workspaces --if-present",
    "test:bidsphere": "npm run test --workspace=apps/bidsphere",
    "test:pdm": "npm run test --workspace=apps/pdm",
    "test:gateway": "node --test gateway/tests/unified-auth.test.mjs gateway/tests/gateway-server.test.mjs",
    "test": "npm run test:gateway && npm run test --workspaces --if-present"
  }
}
