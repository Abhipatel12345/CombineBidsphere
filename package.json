{
  "name": "combine-bidsphere",
  "version": "1.0.0",
  "private": true,
  "description": "CombineBidsphere Monorepo containing Bidsphere (Procure-to-Pay) and PDM Frontend",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:bidsphere": "npm run dev --workspace=apps/bidsphere",
    "dev:pdm": "npm run dev --workspace=apps/pdm",
    "build:bidsphere": "npm run build --workspace=apps/bidsphere",
    "build:pdm": "npm run build --workspace=apps/pdm",
    "build": "npm run build --workspaces --if-present",
    "test:bidsphere": "npm run test --workspace=apps/bidsphere",
    "test:pdm": "npm run test --workspace=apps/pdm",
    "test": "npm run test --workspaces --if-present"
  }
}
